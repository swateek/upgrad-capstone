# Copy to .env in this folder (final-capstone-project/demo/swateek/procurement-and-vendor-review/.env). .env is never committed.

# --- active domain pack -----------------------------------------------------------------
DOMAIN=procurement

# --- provider: siliconflow | upgrad ------------------------------------------------------
# One switch for chat, embeddings and rerank (models per provider: backend/src/copilot/llm/providers.py).
#   siliconflow  Qwen3-8B, Qwen3-Embedding-0.6B, Qwen3-Reranker-8B on SiliconFlow
#   upgrad       Qwen3-8B on the course chat endpoint, bge-small-en-v1.5 on the course embedding
#                endpoint, Qwen3-8B (course chat) as the listwise reranker. No SiliconFlow calls.
# Each provider has its own Qdrant collection, so switching never rebuilds an index.
# (LLM_PROVIDER, the old name, is still read.)
PROVIDER=siliconflow
CHAT_MODEL=Qwen/Qwen3-8B

# SiliconFlow: chat, embeddings, rerank, and the content-check judge (eval.judge, SiliconFlow runs only).
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# upgrad course endpoints (group 031-045). Keys from the coordinator; cert paths relative to this folder.
UPGRAD_CHAT_BASE_URL=https://103.42.50.41:1033/v1
UPGRAD_CHAT_API_KEY=
UPGRAD_CHAT_CA_CERT=certs/vm05-ca.crt
UPGRAD_EMBED_BASE_URL=https://103.42.50.41:1035/v1
UPGRAD_EMBED_API_KEY=
UPGRAD_EMBED_CA_CERT=certs/vm02-ca.crt
# upgrad: Qwen3-8B on the course chat endpoint ranks the fused top-20 | none: hybrid only
UPGRAD_RERANKER=upgrad

# Qwen3 thinking mode. SiliconFlow defaults it ON; keep false unless running the CoT experiment.
ENABLE_THINKING=false

# --- Track B limits (enforced on every provider) ----------------------------------------
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
DEFAULT_MAX_TOKENS=768

# --- client-side gates (SiliconFlow; upgrad is fixed at 1 active request per key) ----------
REQUESTS_PER_MINUTE=60
MAX_CONCURRENCY=2

# --- tracing (Langfuse Cloud) ------------------------------------------------------------
# Tracing is on when both keys are set. EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# TRACING_ENABLED=true
# TRACE_ENVIRONMENT=development

# --- agent budgets per query (Track B) -----------------------------------------------------
# AGENT_STEP_LIMIT=10      # model calls, all roles
# AGENT_TOOL_LIMIT=10
# AGENT_TOKEN_LIMIT=40000

# --- cache and rate limits (Docker sets REDIS_URL; unset = in-process, single worker) ----
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_CHAT_PER_MIN=10   # agent turns per conversation
# RATE_LIMIT_IP_PER_MIN=60     # all API calls per client

# --- host ports (this app uses 3400 onwards) ---------------------------------------------
# WEB_PORT=3400
# API_PORT=3401
# QDRANT_PORT=3402
