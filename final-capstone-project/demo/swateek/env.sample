# Copy to .env in this folder (final-capstone-project/demo/swateek/.env). .env is never committed.

# --- active domain pack -----------------------------------------------------------------
DOMAIN=procurement

# --- chat model -------------------------------------------------------------------------
# siliconflow (active). "course" is planned for later and not wired yet.
LLM_PROVIDER=siliconflow
CHAT_MODEL=Qwen/Qwen3-8B

# SiliconFlow API key (also used for embeddings and rerank).
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# Qwen3 thinking mode. SiliconFlow defaults it ON; keep false unless running the CoT experiment.
ENABLE_THINKING=false

# --- Track B limits (enforced on every provider) ----------------------------------------
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
DEFAULT_MAX_TOKENS=768

# --- client-side gates ------------------------------------------------------------------
REQUESTS_PER_MINUTE=60
MAX_CONCURRENCY=2

# --- tracing (Langfuse Cloud) ------------------------------------------------------------
# Tracing is on when both keys are set. EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# TRACING_ENABLED=true
# TRACE_ENVIRONMENT=development

# --- agent budgets per query (Track B) -----------------------------------------------------
# AGENT_STEP_LIMIT=10      # model calls, all roles
# AGENT_TOOL_LIMIT=10
# AGENT_TOKEN_LIMIT=40000

# --- cache and rate limits (Docker sets REDIS_URL; unset = in-process, single worker) ----
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_CHAT_PER_MIN=10   # agent turns per conversation
# RATE_LIMIT_IP_PER_MIN=60     # all API calls per client

# --- host ports (this app uses 3400 onwards) ---------------------------------------------
# WEB_PORT=3400
# API_PORT=3401
# QDRANT_PORT=3402
