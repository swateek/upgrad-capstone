# Copy to .env in this folder (final-capstone-project/demo/swateek/us-customs-assistant/.env).
# .env is never committed. upgrad only: there is no other model provider in this app.

# --- upgrad course endpoints (group 031-045). Keys from the coordinator. --------------------
# Cert paths are relative to this folder.
UPGRAD_CHAT_BASE_URL=https://103.42.50.41:1033/v1
UPGRAD_CHAT_API_KEY=
UPGRAD_CHAT_CA_CERT=certs/vm05-ca.crt
UPGRAD_EMBED_BASE_URL=https://103.42.50.41:1035/v1
UPGRAD_EMBED_API_KEY=
UPGRAD_EMBED_CA_CERT=certs/vm02-ca.crt
CHAT_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=bge-small-en-v1.5

# Reranker under study: none | listwise (Qwen3-8B on the course chat endpoint) | cross_encoder
RERANKER=none

# Qwen3 thinking mode: off on every default path.
ENABLE_THINKING=false

# --- Track B limits (enforced on every call) -------------------------------------------------
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
DEFAULT_MAX_TOKENS=768
JSON_RETRIES=2
REQUESTS_PER_MINUTE=60

# --- agent ------------------------------------------------------------------------------------
# planner | router | tool_calling | single_rag
AGENT_MODE=planner
# AGENT_STEP_LIMIT=10       # model calls per question (listwise rerank calls count)
# AGENT_TOOL_LIMIT=10       # tool calls per question
# AGENT_TOKEN_LIMIT=12000   # tokens per question

# --- tracing: this app's own Langfuse project ------------------------------------------------
# On when both keys are set. EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# TRACE_ENVIRONMENT=development

# --- cache, rate limits, sessions (Docker sets REDIS_URL; unset = in-process) -----------------
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_CHAT_PER_MIN=10
# RATE_LIMIT_IP_PER_MIN=60
# ANSWER_CACHE_ENABLED=true     # set false for official eval runs
# SESSION_TTL_S=21600

# --- host ports (this app uses 3500 onwards; the procurement app uses 3400-3402) ---------------
# WEB_PORT=3500
# API_PORT=3501
# QDRANT_PORT=3502
