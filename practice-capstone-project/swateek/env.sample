# Copy this file to .env in this folder, or any parent folder up to the repository root.
# Leave .env uncommitted. See README.md for how to create each value.

# Gemini API key from Google AI Studio. GEMINI_API_KEY is accepted if this name is absent.
GOOGLE_API_KEY=

# Hugging Face read token (starts with hf_). Used for the MiniLM download.
HF_TOKEN=
